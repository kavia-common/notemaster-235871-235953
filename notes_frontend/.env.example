# Frontend configuration for NoteMaster (Next.js static export)
#
# Since `next.config.ts` uses `output: "export"`, this app is built as static files.
# Any runtime configuration must be baked in at build time via NEXT_PUBLIC_* vars.

# Base URL of the notes backend API (FastAPI)
NEXT_PUBLIC_NOTES_API_BASE_URL=https://your-backend.example.com
